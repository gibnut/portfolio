{
  "app": "npx tsc && npx tsx bin/app.ts",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "yarn.lock",
      "node_modules",
      "dist",
      "cdk.out"
    ]
  },
  "context": {
    "accountId": "000000000000",
    "domainName": "your-domain.com",
    "cloudfrontDistributionArn": "",
    "pandasLayerArn": ""
  }
}
